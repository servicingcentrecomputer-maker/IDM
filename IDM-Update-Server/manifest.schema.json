{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/IDM-Update-Server/main/manifest.schema.json",
  "title": "IDM release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_name",
    "channel",
    "latest_version",
    "minimum_supported_version",
    "release_date",
    "download_url",
    "sha256",
    "mandatory",
    "manifest_signature"
  ],
  "properties": {
    "app_name": {
      "const": "IDM"
    },
    "channel": {
      "enum": ["stable", "beta"]
    },
    "latest_version": {
      "$ref": "#/$defs/semver"
    },
    "minimum_supported_version": {
      "$ref": "#/$defs/semver"
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "release_notes": {
      "oneOf": [
        { "type": "string", "maxLength": 20000 },
        {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string" }
        }
      ]
    },
    "download_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*\\.exe$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "mandatory": {
      "type": "boolean"
    },
    "manifest_signature": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
